<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.tailspind</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/tailspind</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>com.apple.tailspind</key>
		<true/>
	</dict>
	<key>ProcessType</key>
	<string>Adaptive</string>
	<key>EnablePressuredExit</key>
	<true/>
</dict>
</plist>
